---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 첫 화면 문구. 문장을 바꾸려면 여기만 고치면 된다.
const heroTitle = 'Accelerating the development of materials and devices for decarbonization';
const heroText =
  'Grounded in human domain expertise and powered by robotics and AI, we build autonomous laboratories that develop materials and optimize devices for next-generation decarbonization technologies—faster, smarter, and more reproducibly.';

// 오른쪽 영상 목록. 좌우 화살표로 넘겨 볼 수 있고, 첫 번째 영상이 먼저 재생된다.
// 영상은 public/videos/ 에 웹용으로 줄인 파일(이름 끝 -web.mp4)로 넣는다.
const videos = [
  { src: '/videos/chemspeed-web.mp4', label: 'Chemspeed robotic platform' },
  { src: '/videos/ot2-web.mp4', label: 'Opentrons OT-2' },
];

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero" slot="hero">
    <div class="hero-inner">
    <div class="hero-text">
      <h1>{heroTitle}</h1>
      <p>{heroText}</p>
      <a class="hero-button" href="/research">Explore our research</a>
    </div>
    <div class="hero-media">
      <div class="slider">
        <div class="frame">
        {videos.map((v, i) => (
          <video
            src={v.src}
            class={i === 0 ? 'active' : undefined}
            autoplay={i === 0}
            preload={i === 0 ? 'auto' : 'metadata'}
            muted
            loop
            playsinline
            aria-label={v.label}
          ></video>
        ))}
        {videos.length > 1 && (
          <>
            <button class="nav prev" type="button" aria-label="Previous video">&#8249;</button>
            <button class="nav next" type="button" aria-label="Next video">&#8250;</button>
          </>
        )}
        </div>
      </div>
    </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="news">
      <h2>Latest News</h2>
      <ul>
        {news.map((item) => (
          <li>{item.data.date.toISOString().slice(0, 10)} — {item.data.title}</li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<script>
  // 화살표를 누르면 다음/이전 영상으로 바꾸고 처음부터 재생한다
  const slider = document.querySelector('.slider');
  if (slider) {
    const vids = [...slider.querySelectorAll('video')];
    let current = 0;
    const show = (n: number) => {
      vids[current].pause();
      vids[current].classList.remove('active');
      current = (n + vids.length) % vids.length;
      const v = vids[current];
      v.classList.add('active');
      v.currentTime = 0;
      v.play();
    };
    slider.querySelector('.prev')?.addEventListener('click', () => show(current - 1));
    slider.querySelector('.next')?.addEventListener('click', () => show(current + 1));
  }
</script>

<style>
  /* 첫 화면: 회색 바탕은 화면 폭 전체, 문구와 영상은 상단 메뉴와 같은 폭 안에 정렬 */
  .hero {
    background: #ececec;
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 16px;
    display: grid;
    /* 왼쪽 문구 : 오른쪽 영상 = 5 : 6 */
    grid-template-columns: 5fr 6fr;
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0;
  }

  .hero h1 {
    margin: 0 0 18px;
    font-family: 'Source Sans 3', system-ui, sans-serif;
    font-size: 2.3rem;
    font-weight: 700;
    text-wrap: balance; /* 줄 길이를 고르게 */
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-accent); /* KAIST Dark Blue */
  }

  .hero p {
    margin: 0 0 28px;
    max-width: 34em;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #333;
  }

  .hero-button {
    align-self: flex-start;
    padding: 14px 22px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .hero-button:hover {
    background: var(--color-accent-medium);
  }

  .hero-media {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* 영상 칸: 높이는 Chemspeed 영상 비율(1328×836) 기준으로 고정.
     세로로 긴 영상은 같은 높이로 가운데에 두고, 양옆은 배경(회색) 그대로 둔다 */
  .slider {
    width: 100%;
    aspect-ratio: 1328 / 836;
    display: flex;
    justify-content: center;
  }

  /* 실제 영상 크기에 딱 맞는 틀 — 화살표가 영상 양 끝에 붙는다 */
  .frame {
    position: relative;
    height: 100%;
    max-width: 100%;
  }

  .slider video {
    height: 100%;
    width: auto;
    max-width: 100%;
    display: none;
  }

  .slider video.active {
    display: block;
  }

  /* 좌우 화살표 */
  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    padding: 0 0 4px;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
  }

  .nav:hover {
    background: var(--color-accent-medium);
  }

  .prev {
    left: 12px;
  }

  .next {
    right: 12px;
  }

  .news {
    margin: 48px 0;
  }

  /* 휴대폰 화면: 문구 위, 영상 아래 */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      padding: 0;
    }

    .hero-text {
      padding: 36px 16px;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .hero-inner {
      gap: 0;
      padding-top: 0;
      padding-bottom: 0;
    }
  }
</style>

---
import fs from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 첫 화면 문구. 문장을 바꾸려면 여기만 고치면 된다.
const heroTitle = 'Accelerating the discovery of materials and devices for decarbonization';
const heroText =
  'By combining robotics, AI, and human expertise, the Jiheon Kim Group at KAIST builds self-driving laboratories that explore materials and devices faster, smarter, and more reproducibly.';

// 오른쪽 영상: public/videos/chemspeed.mp4 를 넣으면 자동으로 재생된다.
const videoSrc = '/videos/chemspeed.mp4';
const hasVideo = fs.existsSync(`public${videoSrc}`);

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero" slot="hero">
    <div class="hero-inner">
    <div class="hero-text">
      <h1>{heroTitle}</h1>
      <p>{heroText}</p>
      <a class="hero-button" href="/research">Explore our research</a>
    </div>
    <div class="hero-media">
      {hasVideo ? (
        <video src={videoSrc} autoplay muted loop playsinline aria-label="Chemspeed robotic platform"></video>
      ) : (
        <div class="media-empty">Chemspeed video<br /><small>public/videos/chemspeed.mp4</small></div>
      )}
    </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="news">
      <h2>Latest News</h2>
      <ul>
        {news.map((item) => (
          <li>{item.data.date.toISOString().slice(0, 10)} — {item.data.title}</li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<style>
  /* 첫 화면: 회색 바탕은 화면 폭 전체, 문구와 영상은 상단 메뉴와 같은 폭 안에 정렬 */
  .hero {
    background: #ececec;
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 16px;
    display: grid;
    /* 왼쪽 문구 : 오른쪽 영상 = 5 : 6 */
    grid-template-columns: 5fr 6fr;
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0;
  }

  .hero h1 {
    margin: 0 0 18px;
    font-family: 'Source Sans 3', system-ui, sans-serif;
    font-size: 2.6rem;
    font-weight: 700;
    max-width: 18em;
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: #1a1a1a;
  }

  .hero p {
    margin: 0 0 28px;
    max-width: 34em;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #333;
  }

  .hero-button {
    align-self: flex-start;
    padding: 14px 22px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .hero-button:hover {
    background: var(--color-accent-medium);
  }

  .hero-media {
    position: relative;
    display: flex;
    align-items: center;
  }

  /* 영상이 잘리지 않도록 칸 폭에 맞춰 원래 비율 그대로 보여준다 */
  .hero-media video {
    display: block;
    width: 100%;
    height: auto;
  }

  .media-empty {
    width: 100%;
    aspect-ratio: 16 / 10;
    background: #d9d9d9;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    color: #888;
  }

  .news {
    margin: 48px 0;
  }

  /* 휴대폰 화면: 문구 위, 영상 아래 */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      padding: 0;
    }

    .hero-text {
      padding: 36px 16px;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .hero-inner {
      gap: 0;
      padding-top: 0;
      padding-bottom: 0;
    }
  }
</style>

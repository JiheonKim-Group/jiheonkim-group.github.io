---
import fs from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import captions from '../content/home-slides.json';

// 첫 화면 문구. 문장을 바꾸려면 여기만 고치면 된다.
const heroTitle = 'Accelerating the development of materials and devices for decarbonization';
const heroText =
  'Grounded in human domain expertise and powered by robotics and AI, we build autonomous laboratories that develop materials and optimize devices for next-generation decarbonization technologies—faster, smarter, and more reproducibly.';

// 오른쪽 슬라이드: public/home/ 폴더의 영상(.mp4 .webm)·사진(.jpg .png .webp)을 파일 이름 순서로 자동 표시.
// 순서는 파일 이름 앞 번호로 정한다 (예: 01-chemspeed.mp4, 02-ot2.mp4, 03-ocx25-dataset.webp).
const videoExt = /\.(mp4|webm)$/i;
const imageExt = /\.(jpe?g|png|webp|gif)$/i;
const slides = fs
  .readdirSync('public/home')
  .filter((f) => videoExt.test(f) || imageExt.test(f))
  .sort()
  .map((f) => ({
    src: `/home/${f}`,
    type: videoExt.test(f) ? 'video' : 'image',
    label: f.replace(/^\d+[-_]?/, '').replace(/\.[^.]+$/, '').replace(/[-_]/g, ' '),
    // 슬라이드 아래 글: src/content/home-slides.json 에서 파일 이름 앞 번호로 찾는다
    caption: (captions as Record<string, { text?: string; url?: string }>)[f.match(/^\d+/)?.[0] ?? ''],
  }));

const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <section class="hero" slot="hero">
    <div class="hero-inner">
    <div class="hero-text">
      <h1>{heroTitle}</h1>
      <p>{heroText}</p>
      <a class="hero-button" href="/research">Explore our research</a>
    </div>
    <div class="hero-media">
      <div class="slider">
        <div class="frame">
        {slides.map((v, i) =>
          v.type === 'video' ? (
            <video
              src={v.src}
              class={i === 0 ? 'slide active' : 'slide'}
              autoplay={i === 0}
              preload={i === 0 ? 'auto' : 'metadata'}
              muted
              loop
              playsinline
              aria-label={v.label}
            ></video>
          ) : (
            <img src={v.src} class={i === 0 ? 'slide active' : 'slide'} alt={v.label} loading={i === 0 ? 'eager' : 'lazy'} />
          ),
        )}
        {slides.map((v, i) => (
          <div class={i === 0 ? 'caption active' : 'caption'}>
            {v.caption?.text &&
              (v.caption.url ? (
                <a href={v.caption.url} target="_blank" rel="noopener" set:html={v.caption.text} />
              ) : (
                <span set:html={v.caption.text} />
              ))}
          </div>
        ))}
        {slides.length > 1 && (
          <>
            <button class="nav prev" type="button" aria-label="Previous video">&#8249;</button>
            <button class="nav next" type="button" aria-label="Next video">&#8250;</button>
          </>
        )}
        </div>
      </div>
    </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="news">
      <h2>Latest News</h2>
      <ul>
        {news.map((item) => (
          <li>{item.data.date.toISOString().slice(0, 10)} — {item.data.title}</li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>

<script>
  // 화살표를 누르면 다음/이전 슬라이드로 바꾼다. 영상이면 처음부터 재생한다.
  const slider = document.querySelector('.slider');
  if (slider) {
    const items = [...slider.querySelectorAll<HTMLElement>('.slide')];
    const caps = [...slider.querySelectorAll<HTMLElement>('.caption')];
    let current = 0;
    const show = (n: number) => {
      const prev = items[current];
      if (prev instanceof HTMLVideoElement) prev.pause();
      prev.classList.remove('active');
      caps[current]?.classList.remove('active');
      current = (n + items.length) % items.length;
      const next = items[current];
      next.classList.add('active');
      caps[current]?.classList.add('active');
      place();
      if (next instanceof HTMLVideoElement) {
        next.currentTime = 0;
        next.play();
      }
    };
    // 출처 글을 실제로 보이는 영상/사진의 오른쪽 아래 끝에 맞춘다 (비율이 칸과 달라 여백이 생겨도)
    const frame = slider.querySelector<HTMLElement>('.frame')!;
    const place = () => {
      const el = items[current];
      const cap = caps[current];
      if (!cap) return;
      const iw = el instanceof HTMLVideoElement ? el.videoWidth : (el as HTMLImageElement).naturalWidth;
      const ih = el instanceof HTMLVideoElement ? el.videoHeight : (el as HTMLImageElement).naturalHeight;
      const r = el.getBoundingClientRect();
      const f = frame.getBoundingClientRect();
      let dw = r.width;
      let dh = r.height;
      if (iw && ih) {
        const k = Math.min(r.width / iw, r.height / ih);
        dw = iw * k;
        dh = ih * k;
      }
      cap.style.top = `${r.top - f.top + (r.height + dh) / 2}px`;
      cap.style.right = `${f.right - (r.left + (r.width + dw) / 2)}px`;
    };
    items.forEach((el) => {
      el.addEventListener('loadedmetadata', place);
      el.addEventListener('load', place);
    });
    window.addEventListener('resize', place);
    place();

    slider.querySelector('.prev')?.addEventListener('click', () => show(current - 1));
    slider.querySelector('.next')?.addEventListener('click', () => show(current + 1));
  }
</script>

<style>
  /* 첫 화면: 회색 바탕은 화면 폭 전체, 문구와 영상은 상단 메뉴와 같은 폭 안에 정렬 */
  .hero {
    background: var(--color-bg);
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 16px;
    display: grid;
    /* 왼쪽 문구 : 오른쪽 영상 = 5 : 6 */
    grid-template-columns: 5fr 6fr;
    gap: 48px;
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .hero-text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0;
  }

  .hero h1 {
    margin: 0 0 18px;
    font-family: 'IBM Plex Sans', system-ui, sans-serif;
    font-size: 2.3rem;
    font-weight: 700;
    text-wrap: balance; /* 줄 길이를 고르게 */
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--color-accent); /* KAIST Dark Blue */
  }

  .hero p {
    margin: 0 0 28px;
    max-width: 34em;
    font-size: 1.1rem;
    line-height: 1.6;
    color: #333;
  }

  .hero-button {
    align-self: flex-start;
    padding: 14px 22px;
    background: var(--color-accent);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
  }

  .hero-button:hover {
    background: var(--color-accent-medium);
  }

  .hero-media {
    position: relative;
    display: flex;
    align-items: center;
    padding-bottom: 28px; /* 슬라이드 아래 출처 글 자리 */
  }

  /* 영상 칸: 높이는 Chemspeed 영상 비율(1328×836) 기준으로 고정.
     세로로 긴 영상은 같은 높이로 가운데에 두고, 양옆은 배경(회색) 그대로 둔다 */
  .slider {
    width: 100%;
    aspect-ratio: 1328 / 836;
    display: flex;
    justify-content: center;
  }

  /* 실제 영상 크기에 딱 맞는 틀 — 화살표가 영상 양 끝에 붙는다 */
  .frame {
    position: relative;
    height: 100%;
    max-width: 100%;
  }

  .slide {
    height: 100%;
    width: auto;
    max-width: 100%;
    display: none;
  }

  img.slide {
    object-fit: contain;
  }

  .slide.active {
    display: block;
  }

  /* 슬라이드 아래 오른쪽 출처(논문) 글 */
  .caption {
    position: absolute;
    top: 100%; /* 실제 위치는 아래 스크립트가 영상 크기에 맞춰 조정 */
    right: 0;
    display: none;
    margin: 6px 0 0;
    font-size: 0.75rem;
    color: #555;
    white-space: nowrap;
  }

  .caption.active {
    display: block;
  }

  .caption a {
    color: inherit;
    text-decoration: none;
  }

  .caption a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* 좌우 화살표 */
  .nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 40px;
    height: 40px;
    padding: 0 0 4px;
    border: 0;
    border-radius: 50%;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
  }

  .nav:hover {
    background: var(--color-accent-medium);
  }

  .prev {
    left: 12px;
  }

  .next {
    right: 12px;
  }

  /* 홈 화면: 첫 화면 바로 아래에 하단 배너가 이어지게 */
  :global(.site-footer) {
    margin-top: 0;
  }

  .news {
    margin: 48px 0;
  }

  /* 휴대폰 화면: 문구 위, 영상 아래 */
  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      padding: 0;
    }

    .hero-text {
      padding: 36px 16px;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .caption {
      margin-right: 12px; /* 휴대폰: 화면 끝에 붙지 않게 */
    }

    .hero-inner {
      gap: 0;
      padding-top: 0;
      padding-bottom: 0;
    }
  }
</style>

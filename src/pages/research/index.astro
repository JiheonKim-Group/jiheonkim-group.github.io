---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

// Research topics from src/content/research/, sorted by order.
const topics = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

// Intro
const intro =
  'We combine human domain expertise with laboratory automation and AI to accelerate the development of materials and devices, with a focus on decarbonization technologies.';

const sections = await Promise.all(
  topics.map(async (t) => {
    const { Content } = await render(t);
    return { t, Content };
  }),
);
---

<BaseLayout title="Research">
  <h1 class="page-title">Research</h1>

  {topics.length === 0 ? <p>Coming soon.</p> : (
    <>
      <p class="intro">{intro}</p>

      {sections.map(({ t, Content }) => (
        <section class:list={["topic", { wide: t.data.wide }]} id={t.id}>
          <div class="topic-text">
            <h2>{t.data.title}</h2>
            {t.data.summary && <p class="summary" set:html={t.data.summary} />}
            <div class="body"><Content /></div>
          </div>
          {t.data.image && (
            <figure class="topic-image">
              {t.data.imageTitle && <p class="image-title" set:html={t.data.imageTitle} />}
              {/* Click to open in the lightbox */}
              <button type="button" class="zoom" aria-label={`Enlarge: ${t.data.title}`}>
                <img src={t.data.image} alt={t.data.title} loading="lazy" />
              </button>
              <figcaption>Click to enlarge</figcaption>
            </figure>
          )}
        </section>
      ))}
    </>
  )}

  {/* Lightbox: click anywhere or press Esc to close */}
  <div class="lightbox" hidden>
    <img alt="" />
  </div>
</BaseLayout>

<script>
  const box = document.querySelector<HTMLElement>('.lightbox');
  const big = box?.querySelector('img');
  if (box && big) {
    document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((btn) => {
      btn.addEventListener('click', () => {
        const img = btn.querySelector('img');
        if (!img) return;
        big.src = img.src;
        big.alt = img.alt;
        box.hidden = false;
        document.body.style.overflow = 'hidden';
      });
    });
    const close = () => {
      box.hidden = true;
      document.body.style.overflow = '';
    };
    box.addEventListener('click', close);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !box.hidden) close();
    });
  }
</script>

<style>
  .intro {
    max-width: 46em;
    margin: 0 0 48px;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-accent);
  }

  /* Topic: text left, figure right (alternating) */
  .topic {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: 'text image';
    gap: 48px;
    align-items: center;
    padding: 40px 0;
    border-top: 1px solid #ddd;
  }

  .topic:nth-of-type(even) {
    grid-template-areas: 'image text';
  }

  /* wide: figure below the text at full width */
  .topic.wide,
  .topic.wide:nth-of-type(even) {
    grid-template-columns: 1fr;
    grid-template-areas: 'text' 'image';
  }

  .topic.wide .topic-text {
    max-width: 50em;
  }

  .topic-text {
    grid-area: text;
  }

  .topic-image {
    grid-area: image;
    margin: 0;
  }

  /* Figure heading (imageTitle) */
  .image-title {
    margin: 0 0 10px;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .topic-image .zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .topic-image img {
    display: block;
    width: 100%;
    border-radius: 12px;
  }

  .topic-image figcaption {
    margin-top: 6px;
    text-align: right;
    font-size: 0.75rem;
    color: #888;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0, 0, 0, 0.85);
    cursor: zoom-out;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    background: #fff;
    border-radius: 8px;
  }


  .topic h2 {
    margin: 0 0 8px;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-accent);
  }

  .summary {
    margin: 0 0 16px;
    font-size: 1.05rem;
    font-weight: 500;
    color: #555;
  }

  .body :global(p) {
    margin: 0 0 12px;
    line-height: 1.75;
    color: #333;
  }


  /* Mobile: text, then figure */
  @media (max-width: 900px) {
    .topic,
    .topic:nth-of-type(even) {
      grid-template-columns: 1fr;
      grid-template-areas: 'text' 'image';
    }
  }
</style>

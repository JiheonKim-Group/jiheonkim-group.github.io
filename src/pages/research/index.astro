---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

// Research topics from src/content/research/, sorted by order.
const topics = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);

// Video shown above the intro (YouTube embed, privacy-enhanced domain).
const video = {
  id: '76js2AphU5g',
  title: '결국 돈은 이걸 가진 사람이 다 가져갑니다 (샘 올트먼·유발 하라리 외)',
  channel: '백만수무강',
};

// Intro: a short setup, a question, and the answer. Each part has an English line with Korean underneath.
const intro = {
  setup: {
    en: "AI has outpaced every prediction. In just a few years, even the experts' answer to \"what comes next?\" has changed many times.",
    ko: 'AI는 모든 예측을 앞질렀습니다. "다음은 무엇인가"에 대한 전문가들의 답도 불과 몇 년 새 여러 번 바뀌었습니다.',
  },
  question: {
    en: 'AI is reshaping research, and robots are bringing AI into the lab. What direction, then, should we researchers pursue?',
    ko: 'AI는 연구를 바꾸고, 로봇은 그 AI를 실험실로 들여오고 있습니다. 그렇다면 연구자인 우리가 지향해야 할 방향은 무엇일까요?',
  },
  // Answer: one paragraph per entry, each with its Korean line. <em class="key"> highlights a phrase.
  answer: [
    {
      en: 'We believe the way forward still begins with domain expertise: deep knowledge of the field, hands-on know-how at the bench, and the ability to ask <em class="key">the right scientific questions</em> and scale them with automation and AI.',
      ko: '우리는 그 길이 여전히 domain expertise에서 시작한다고 믿습니다. 연구 분야에 대한 깊은 이해와 손으로 익힌 실험 노하우, 그리고 <em class="key">올바른 scientific question</em>을 세우고 이를 자동화와 AI로 확장하는 힘입니다.',
    },
    {
      en: 'AI and robots can take over parts of research, but experts broadly agree that complex, hands-on physical experiments will take the longest to automate.',
      ko: 'AI와 로봇이 연구의 일부를 대신할 수는 있지만, 손을 쓰는 복잡한 물리적 실험은 자동화되기까지 가장 오래 걸릴 것이라는 데 전문가들의 의견이 모입니다.',
    },
    {
      en: 'Automated laboratories will therefore operate under constraints for years to come. Within them, only hands-on experience and deep expertise can tell us which experiments are worth automating, how to make that automation work, and <em class="key">which scientific questions will create the greatest value</em>.',
      ko: '따라서 자동화 실험실은 당분간 제약 속에서 운영될 수밖에 없습니다. 그 안에서 어떤 실험을 자동화할 가치가 있는지, 그 자동화를 어떻게 구현할지, 그리고 <em class="key">어떤 scientific question이 가장 큰 가치를 만드는지</em>는 손으로 익힌 경험과 깊은 전문성만이 알려 줍니다.',
    },
  ],
};

const sections = await Promise.all(
  topics.map(async (t) => {
    const { Content } = await render(t);
    return { t, Content };
  }),
);
---

<BaseLayout title="Research">
  <h1 class="page-title">Research</h1>

  {topics.length === 0 ? <p>Coming soon.</p> : (
    <>
      <figure class="video">
        <div class="video-frame">
          <iframe
            src={`https://www.youtube-nocookie.com/embed/${video.id}`}
            title={video.title}
            loading="lazy"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
        <figcaption>
          <a href={`https://www.youtube.com/watch?v=${video.id}`} target="_blank" rel="noopener">{`https://www.youtube.com/watch?v=${video.id}`}</a>
        </figcaption>
      </figure>

      <div class="intro">
        <p class="setup">{intro.setup.en}<span class="ko">{intro.setup.ko}</span></p>
        <p class="question">{intro.question.en}<span class="ko">{intro.question.ko}</span></p>
        <div class="answer">
          {intro.answer.map((s) => (
            <p><Fragment set:html={s.en} /><span class="ko"><Fragment set:html={s.ko} /></span></p>
          ))}
        </div>
      </div>

      {/* Each topic: title, summary (EN + KO), figure, then body, stacked at full width */}
      {sections.map(({ t, Content }) => (
        <section class="topic" id={t.id}>
          <h2>{t.data.title}</h2>
          {t.data.summary && <p class="summary" set:html={t.data.summary} />}
          {t.data.summaryKo && <p class="summary ko" set:html={t.data.summaryKo} />}
          {t.data.image && (
            <figure class="topic-image">
              {t.data.imageTitle && <p class="image-title" set:html={t.data.imageTitle} />}
              {/* Click to open in the lightbox */}
              <button type="button" class="zoom" aria-label={`Enlarge: ${t.data.title}`}>
                <img src={t.data.image} alt={t.data.title} loading="lazy" />
              </button>
              <figcaption>Click to enlarge</figcaption>
            </figure>
          )}
          {/* In the body, a blockquote (a line starting with ">") is the Korean line under the paragraph above it */}
          <div class="body"><Content /></div>
        </section>
      ))}
    </>
  )}

  {/* Lightbox: click anywhere or press Esc to close */}
  <div class="lightbox" hidden>
    <img alt="" />
  </div>
</BaseLayout>

<script>
  const box = document.querySelector<HTMLElement>('.lightbox');
  const big = box?.querySelector('img');
  if (box && big) {
    document.querySelectorAll<HTMLButtonElement>('.zoom').forEach((btn) => {
      btn.addEventListener('click', () => {
        const img = btn.querySelector('img');
        if (!img) return;
        big.src = img.src;
        big.alt = img.alt;
        box.hidden = false;
        document.body.style.overflow = 'hidden';
      });
    });
    const close = () => {
      box.hidden = true;
      document.body.style.overflow = '';
    };
    box.addEventListener('click', close);
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !box.hidden) close();
    });
  }
</script>

<style>
  /* YouTube embed above the intro: 16:9, capped width */
  .video {
    max-width: 760px;
    margin: 0 auto 40px;
  }

  .video-frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background: #000;
  }

  .video-frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .video figcaption {
    margin-top: 6px;
    text-align: right;
    font-size: 0.8rem;
    color: #888;
  }

  .video figcaption a {
    color: inherit;
  }

  /* Intro: setup -> question -> answer */
  .intro {
    margin: 0 0 56px;
  }

  .intro p {
    margin: 0;
  }

  /* Korean line directly under each English line */
  .intro .ko {
    display: block;
    margin-top: 6px;
    font-size: 0.95rem;
    font-weight: 400;
    line-height: 1.6;
    color: #666;
  }

  .setup {
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-accent);
  }

  /* Korean under the setup and the question: blue, to match the English */
  .setup .ko,
  .question .ko {
    color: var(--color-accent);
  }

  .question {
    margin-top: 28px !important;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
    color: var(--color-accent);
  }

  /* Answer: accent bar on the left, like a reply; one sentence per paragraph */
  .answer {
    margin-top: 20px;
    padding: 4px 0 4px 20px;
    border-left: 4px solid var(--color-accent-light);
  }

  .answer p {
    font-size: 1.15rem;
    font-weight: 400;
    line-height: 1.6;
    color: #222;
  }

  .answer p + p {
    margin-top: 16px;
  }

  /* Highlighted phrases: bold, in the accent color (:global because they come from set:html) */
  .answer :global(.key) {
    font-style: normal;
    font-weight: 700;
    color: var(--color-accent-light); /* KAIST Light Blue */
  }

  /* Topic: stacked at full width */
  .topic {
    padding: 40px 0;
    border-top: 1px solid #ddd;
  }

  /* Figure between the summary and the body, same width as the video above */
  .topic-image {
    max-width: 760px;
    margin: 24px auto 28px;
  }

  /* Figure heading (imageTitle) */
  .image-title {
    margin: 0 0 10px;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .topic-image .zoom {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .topic-image img {
    display: block;
    width: 100%;
    border-radius: 12px;
  }

  .topic-image figcaption {
    margin-top: 6px;
    text-align: right;
    font-size: 0.75rem;
    color: #888;
  }

  /* Lightbox */
  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: rgba(0, 0, 0, 0.85);
    cursor: zoom-out;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    background: #fff;
    border-radius: 8px;
  }


  .topic h2 {
    margin: 0 0 8px;
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--color-accent);
  }

  .summary {
    margin: 0 0 6px;
    font-size: 1.05rem;
    font-weight: 500;
    color: #555;
  }

  /* Korean under the summary */
  .summary.ko {
    margin: 0 0 16px;
    font-size: 0.9rem;
    font-weight: 400;
    color: #777;
  }

  .body :global(p) {
    margin: 0 0 12px;
    line-height: 1.75;
    color: #333;
  }

  /* Korean line under each paragraph (written as a blockquote in Markdown) */
  .body :global(blockquote) {
    margin: -6px 0 16px;
    padding: 0;
    border: 0;
  }

  .body :global(blockquote p) {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.65;
    color: #777;
  }

</style>

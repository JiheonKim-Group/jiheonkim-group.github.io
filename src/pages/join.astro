---
import fs from 'node:fs';
import BaseLayout from '../layouts/BaseLayout.astro';

// 사진: public/images/join/lotte-kaist-rnd-center.jpg 를 넣으면 위쪽에 자동으로 나온다.
const photo = '/images/join/lotte-kaist-rnd-center.jpg';
const hasPhoto = fs.existsSync(`public${photo}`);
const email = 'jiheon.kim@kaist.ac.kr';
// 왼쪽에 표시할 주소
const addresses = [
  { label: 'Lab', text: 'Bldg. W14 (Lotte-KAIST R&D Center), Rm. 401B' },
  { label: 'Student Office', text: 'Bldg. W14 (Lotte-KAIST R&D Center), Rm. 405B' },
];

// 모집 안내 (한국어 먼저, 영어 다음). 문구를 바꾸려면 아래만 고치면 된다.
const intro = {
  en: 'We are looking for researchers eager to pioneer a new research paradigm that harmonizes a deep understanding of chemistry and materials, robotic automation, and AI—and to develop the materials and devices that will make decarbonization a reality.',
  ko: '화학·소재에 대한 깊은 이해, 로봇 자동화, AI가 조화를 이루는 새로운 연구 패러다임에 함께 도전할 연구자를 찾습니다. 이를 통해 탈탄소 기술을 실현할 소재와 소자를 함께 개발할 열정적인 분들을 기다립니다.',
};

const positions = [
  {
    title: 'Graduate Students',
    applyKo: '간단한 자기소개와 성적표를 이메일로 보내주세요.',
    applyEn: 'Send a brief introduction of yourself and your transcripts by email.',
    titleKo: '대학원생 모집',
    en: 'We are looking for motivated graduate students who want to build autonomous laboratories and use them to develop materials and devices for decarbonization. Projects span robotic experimentation, AI/ML-guided optimization, electrochemistry, and nanomaterials synthesis. Students from chemical engineering, chemistry, materials science, mechanical/electrical engineering, and computer science are all welcome.',
    ko: '로봇 기반 자율실험실을 직접 구축하고, 이를 활용해 탈탄소 기술을 위한 소재와 소자를 개발할 대학원생을 모집합니다. 로봇 실험 자동화, AI/ML 기반 최적화, 전기화학, 나노소재 합성 등 다양한 연구를 수행합니다. 화학공학, 화학, 재료, 기계·전기, 컴퓨터 등 전공에 관계없이 환영합니다.',
  },
  {
    title: 'Undergraduate Interns',
    applyKo: '간단한 자기소개와 관심 연구 분야를 이메일로 보내주세요.',
    applyEn: 'Send a brief introduction of yourself and your research interests by email.',
    titleKo: '학부연구생 모집',
    en: 'Undergraduate students can join ongoing projects as research interns (including URP and individual research courses), working closely with graduate students on building automated experimental platforms, data analysis, and materials characterization.',
    ko: '학부생은 연구 인턴(URP, 개별연구 포함)으로 진행 중인 프로젝트에 참여하여, 대학원생과 함께 자동화 실험 플랫폼 구축, 데이터 분석, 소재 분석을 경험할 수 있습니다.',
  },
];

---

<BaseLayout title="Join Us">
  <h1 class="page-title">Join Us</h1>

  <div class="join-top">
    <div class="join-intro">
      <p class="lead">{intro.ko}</p>
      <p class="lead en">{intro.en}</p>
      <dl class="addr">
        <dt>Contact</dt>
        <dd><a href={`mailto:${email}`}>{email}</a></dd>
        {addresses.map((a) => (
          <>
            <dt>{a.label}</dt>
            <dd>{a.text}</dd>
          </>
        ))}
      </dl>
    </div>
    <figure class="join-photo">
      {hasPhoto ? (
        <img src={photo} alt="Lotte-KAIST R&D Center" />
      ) : (
        <span class="photo-empty">Lotte-KAIST R&amp;D Center<br /><small>public/images/join/lotte-kaist-rnd-center.jpg</small></span>
      )}
      <figcaption>
        <span>Lotte-KAIST R&amp;D Center (Bldg. W14), KAIST</span>
      </figcaption>
    </figure>
  </div>

  {positions.map((p) => (
    <section class="position">
      <h2>{p.titleKo} <span class="en-title">{p.title}</span></h2>
      <p>{p.ko}</p>
      <p class="en">{p.en}</p>
      <div class="apply">
        <p><strong>지원 방법:</strong> {p.applyKo}</p>
        <p class="en"><strong>How to apply:</strong> {p.applyEn}</p>
      </div>
    </section>
  ))}

</BaseLayout>

<style>
  /* 왼쪽: 인사말·연락처·주소, 오른쪽: 센터 사진 */
  .join-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    margin-bottom: 24px;
  }

  /* 주소: 항목 이름과 내용을 두 열로 (PI 페이지 연락처 양식) */
  .addr {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 6px 16px;
    margin: 0;
    font-size: 0.95rem;
  }

  .addr dt {
    font-weight: 600;
    color: #555;
    white-space: nowrap;
  }

  .addr dd {
    margin: 0;
  }

  .lead {
    margin: 0 0 8px;
    font-size: 1.35rem;
    font-weight: 600;
    line-height: 1.5;
    color: var(--color-accent);
  }

  .lead.en {
    margin-bottom: 24px;
    font-size: 1.05rem;
    font-weight: 400;
    color: #333;
  }

  /* 영어 문단: 한국어 바로 아래, 조금 작고 회색 */
  .en {
    font-size: 0.95em;
    color: #444;
  }

  .en-title {
    margin-left: 8px;
    font-size: 0.8em;
    font-weight: 500;
    color: #555;
  }

  .join-photo {
    margin: 0;
  }

  .join-photo img,
  .photo-empty {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: 12px;
  }

  .photo-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: #f0f0f0;
    color: #888;
  }

  .join-photo figcaption {
    margin-top: 6px;
    text-align: right;
    font-size: 0.75rem;
    color: #666;
  }

  /* 모집 분야: 파란 소제목 + 가는 선 (PI 페이지 양식) */
  .position {
    margin-top: 40px;
  }

  .position h2 {
    margin: 0 0 4px;
    padding-bottom: 8px;
    border-bottom: 1px solid #ddd;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .position p {
    line-height: 1.75;
  }

  .apply p {
    margin: 0;
  }

  .apply p + p {
    margin-top: 4px;
  }


  .apply {
    margin-top: 16px;
    padding: 12px 16px;
    border-left: 3px solid var(--color-accent-light);
    background: #eef6fc;
  }

  @media (max-width: 900px) {
    .join-top {
      grid-template-columns: 1fr;
      gap: 24px;
    }
  }
</style>

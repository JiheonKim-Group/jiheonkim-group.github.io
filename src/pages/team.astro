---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// 하위 폴더 이름(pi/members/alumni)으로 구성원을 나눈다.
const team = await getCollection('team');
const byGroup = (group: string) =>
  team
    .filter((m) => m.id.startsWith(`${group}/`))
    .sort((a, b) => (a.data.joined?.valueOf() ?? 0) - (b.data.joined?.valueOf() ?? 0));

const groups = [
  { id: 'pi', title: 'Principal Investigator', members: byGroup('pi') },
  { id: 'members', title: 'Current Members', members: byGroup('members') },
  { id: 'alumni', title: 'Alumni', members: byGroup('alumni') },
];
---

<BaseLayout title="Team">
  <h1>Team</h1>
  {groups.map((group) => group.members.length > 0 && (
    <section id={group.id}>
      <h2>{group.title}</h2>
      <ul>
        {group.members.map((m) => (
          <li>
            {m.data.photo && <img src={m.data.photo} alt={m.data.name} width="120" />}
            <strong>{m.data.name}</strong> — {m.data.role}
            {m.data.email && <> (<a href={`mailto:${m.data.email}`}>{m.data.email}</a>)</>}
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

// Number papers from the oldest up.
const sortKey = (p: Awaited<ReturnType<typeof getCollection<'publications'>>>[number]) =>
  [p.data.year, p.data.date?.valueOf() ?? 0, p.id] as const;

const ordered = (await getCollection('publications')).sort((a, b) => {
  const [ya, da, ia] = sortKey(a);
  const [yb, db, ib] = sortKey(b);
  return ya - yb || da - db || ia.localeCompare(ib);
});

const numbered = ordered.map((pub, i) => ({ pub, no: i + 1 })).reverse(); // newest first
const years = [...new Set(numbered.map(({ pub }) => pub.data.year))];
const byYear = years.map((year) => ({
  year,
  items: numbered.filter(({ pub }) => pub.data.year === year),
}));

const linkOf = (d: { doi?: string; url?: string }) =>
  d.doi ? `https://doi.org/${d.doi}` : d.url;

// Bold the PI in author lists.
const PI_NAME = 'Jiheon Kim';
const escapeHtml = (t: string) =>
  t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const authorsHtml = (authors: string) =>
  escapeHtml(authors).replaceAll(PI_NAME, `<strong class="pi">${PI_NAME}</strong>`);
---

<BaseLayout title="Publications">
  <h1 class="page-title">Publications</h1>

  <div class="filters" role="group" aria-label="Filter by year">
    <button type="button" class="pill active" data-year="all" aria-pressed="true">All</button>
    {years.map((year) => (
      <button type="button" class="pill" data-year={year} aria-pressed="false">{year}</button>
    ))}
  </div>

  <div class="meta">
    <p class="total">Total <strong id="pub-count">{numbered.length}</strong></p>
    <p class="legend">† Equal contribution &nbsp;·&nbsp; * Corresponding author</p>
  </div>

  {numbered.length === 0 && <p class="empty">Publications will be listed here soon.</p>}

  {byYear.map(({ year, items }) => (
    <section class="year-group" data-year={year}>
      <h2 class="year">{year}</h2>
      <ol class="pub-list">
        {items.map(({ pub, no }) => {
          const d = pub.data;
          const link = linkOf(d);
          return (
            <li class="pub">
              <span class="no">{no}</span>
              <div class="thumb">
                {d.image ? <img src={d.image} alt="" loading="lazy" /> : <span class="thumb-empty" />}
              </div>
              <div class="body">
                {/* Titles may contain <sub>, <sup>, <em> */}
                <h3 class="title" set:html={d.title} />
                <p class="authors" set:html={authorsHtml(d.authors)} />
                {/* Nature citation style: journal (italic) volume (bold), pages (year). */}
                <p class="citation">
                  {d.journal.startsWith('Preprint') ? d.journal : <em>{d.journal}</em>}
                  {d.volume && <> <strong>{d.volume}</strong></>}
                  {d.pages && <>, {d.pages}</>}
                  {` (${d.year}).`}
                </p>
                {d.highlight && <p class="highlight">{d.highlight}</p>}
              </div>
              {/* LINK sits in its own column so the text block stays vertically centered with the figure */}
              <div class="actions">
                {link && (
                  <a class="link-btn" href={link} target="_blank" rel="noopener">
                    <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true">
                      <path d="M10 14a5 5 0 0 0 7.07 0l3-3a5 5 0 0 0-7.07-7.07l-1.5 1.5M14 10a5 5 0 0 0-7.07 0l-3 3a5 5 0 0 0 7.07 7.07l1.5-1.5"
                        fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
                    </svg>
                    Link
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </section>
  ))}
</BaseLayout>

<script>
  // Year filter
  const pills = document.querySelectorAll<HTMLButtonElement>('.filters .pill');
  const groups = document.querySelectorAll<HTMLElement>('.year-group');
  const count = document.getElementById('pub-count');

  pills.forEach((pill) => {
    pill.addEventListener('click', () => {
      const year = pill.dataset.year;
      pills.forEach((p) => {
        const on = p === pill;
        p.classList.toggle('active', on);
        p.setAttribute('aria-pressed', String(on));
      });
      let total = 0;
      groups.forEach((g) => {
        const show = year === 'all' || g.dataset.year === year;
        g.hidden = !show;
        if (show) total += g.querySelectorAll('.pub').length;
      });
      if (count) count.textContent = String(total);
    });
  });
</script>

<style>
  /* Year filter */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pill {
    padding: 6px 18px;
    border: 0;
    border-radius: 999px;
    background: #f0f0f0;
    color: #444;
    font: inherit;
    font-size: 0.85rem;
    font-weight: 500;
    cursor: pointer;
  }

  .pill:hover {
    background: #e2e2e2;
  }

  .pill.active {
    background: var(--color-accent);
    color: #fff;
    font-weight: 700;
    text-transform: uppercase;
  }

  .pill[data-year='all'] {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    margin-top: 20px;
    font-size: 0.85rem;
    color: var(--color-muted);
  }

  .meta p {
    margin: 0;
  }

  .total strong {
    color: var(--color-text);
  }

  .empty {
    margin: 48px 0;
    color: var(--color-muted);
  }

  /* Year group */
  .year-group {
    margin-top: 48px;
  }

  .year {
    margin: 0;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--color-accent);
    font-size: 1.6rem;
    letter-spacing: -0.01em;
    color: var(--color-accent);
  }

  .pub-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* One paper: number | figure | text | LINK */
  .pub {
    display: grid;
    grid-template-columns: 48px 200px 1fr auto;
    gap: 20px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #e5e5e5;
  }

  .no {
    font-size: 0.85rem;
    font-weight: 600;
    color: #888;
    text-align: center;
  }

  .thumb {
    aspect-ratio: 4 / 3;
    background: #f5f5f5;
    overflow: hidden;
  }

  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    background: #fff;
  }

  .thumb-empty {
    display: block;
    width: 100%;
    height: 100%;
  }

  .body {
    display: flex;
    flex-direction: column;
  }

  .actions {
    align-self: end;
  }

  .title {
    margin: 0 0 10px;
    font-size: 1.15rem;
    line-height: 1.35;
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .authors {
    margin: 0 0 8px;
    font-size: 0.92rem;
    line-height: 1.55;
    color: #444;
  }

  .authors :global(.pi) {
    font-weight: 700;
    color: var(--color-text);
  }

  .title :global(sub),
  .title :global(sup) {
    font-size: 0.7em;
    line-height: 0;
  }

  .citation {
    margin: 0;
    font-size: 0.92rem;
    color: #444;
  }

  /* Optional highlight (e.g. Highly Cited Paper) */
  .highlight {
    align-self: flex-start;
    margin: 10px 0 0;
    padding: 2px 10px;
    border-left: 3px solid var(--color-accent-light);
    background: #eef6fc;
    color: var(--color-accent);
    font-size: 0.82rem;
    font-weight: 600;
  }

  .citation em {
    font-style: italic;
  }

  .link-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 14px;
    white-space: nowrap;
    border: 1px solid var(--color-accent-medium);
    color: var(--color-accent-medium);
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }

  .link-btn:hover {
    background: var(--color-accent-medium);
    color: #fff;
  }

  /* Mobile: figure on top, smaller number */
  @media (max-width: 720px) {
    .pub {
      grid-template-columns: 32px 1fr;
      align-items: start;
    }

    .thumb {
      grid-column: 2;
      max-width: 200px;
    }

    .body,
    .actions {
      grid-column: 2;
    }

    .actions {
      justify-self: end;
    }

    .no {
      grid-row: 1;
      text-align: left;
      padding-top: 2px;
    }
  }
</style>

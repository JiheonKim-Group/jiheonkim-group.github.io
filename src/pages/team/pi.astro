---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

// Link icons (public/images/logo/) and their brand colors
const linkStyles = {
  scholar: { src: '/images/logo/googlescholar.webp', color: '#4285F4' },
  orcid: { src: '/images/logo/orcid.webp', color: '#A6CE39' },
  linkedin: { src: '/images/logo/linkedin.svg', color: '#0A66C2' },
};

// PI entries from src/content/team/pi/
const team = await getCollection('team');
const byGroup = (group: string) =>
  team
    .filter((m) => m.id.startsWith(`${group}/`))
    .sort((a, b) => (a.data.joined?.valueOf() ?? 0) - (b.data.joined?.valueOf() ?? 0));

// PI: photo, name, contact and links, then biography and CV
const pis = await Promise.all(
  byGroup('pi').map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
---

<BaseLayout title="Principal Investigator">
  <section>
    <h1 class="page-title">Principal Investigator</h1>

    {pis.map(({ entry, Content }) => {
      const d = entry.data;
      return (
        <article class="pi">
          <div class="pi-top">
            <div class="pi-photo">
              {d.photo ? <img src={d.photo} alt={d.name} /> : <span class="photo-empty"></span>}
            </div>
            <div class="pi-intro">
              <h2 class="pi-name"><strong>{d.name}</strong>{d.degree && <span class="degree">, {d.degree}</span>}</h2>
              {d.position && <p class="pi-position">{d.position.map((line) => <span>{line}</span>)}</p>}
              <dl class="pi-contact">
                {d.email && <><dt>Email</dt><dd><a href={`mailto:${d.email}`}>{d.email}</a></dd></>}
                {d.office && <><dt>Office</dt><dd>{d.office}</dd></>}
                {d.lab && <><dt>Lab</dt><dd>{d.lab}</dd></>}
                {d.phone && <><dt>Tel.</dt><dd><a href={`tel:${d.phone.replace(/[^+\d]/g, '')}`}>{d.phone}</a></dd></>}
              </dl>
              {d.links && d.links.length > 0 && (
                <p class="pi-links">
                  {d.links.map((l, i) => {
                    const st = l.icon ? linkStyles[l.icon] : undefined;
                    return (
                      <>
                        {i > 0 && <span class="bar" aria-hidden="true">|</span>}
                        <a href={l.url} target="_blank" rel="noopener" style={st && `color:${st.color}`}>
                          {st && <img src={st.src} alt="" width="20" height="20" />}
                          {l.label}
                        </a>
                      </>
                    );
                  })}
                </p>
              )}
            </div>
          </div>

          <section class="cv">
            <h3>Biography</h3>
            <div class="pi-bio"><Content /></div>
          </section>

          {d.cv?.map((sec) => (
            <section class="cv">
              <h3>{sec.heading}</h3>
              <dl>
                {sec.items.map((it) => (
                  <>
                    <dt>{it.period}</dt>
                    <dd>{it.text}{it.advisor && <span class="advisor">{it.advisor}</span>}</dd>
                  </>
                ))}
              </dl>
            </section>
          ))}
        </article>
      );
    })}
  </section>

</BaseLayout>

<style>
  /* Photo left, details right */
  .pi-top {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 40px;
    align-items: start;
  }

  /* Photo: 3:4, rounded corners */
  .pi-photo img,
  .photo-empty {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border-radius: 16px;
    background: #f0f0f0;
  }

  .pi-name {
    margin: 12px 0 16px;
    font-size: 1.9rem;
    font-weight: 400;
    line-height: 1.2;
  }

  .pi-name strong {
    font-weight: 700;
  }

  /* ", Ph.D." slightly smaller */
  .pi-name .degree {
    font-size: 0.72em;
    color: #444;
  }

  /* Titles under the name */
  .pi-position {
    margin: -6px 0 18px;
    line-height: 1.5;
    color: #333;
  }

  .pi-position span {
    display: block;
  }

  .pi-position span:first-child {
    font-weight: 600;
  }

  /* Contact: two-column label/value layout */
  .pi-contact {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 16px;
    margin: 0 0 14px;
    font-size: 0.95rem;
  }

  .pi-contact dt {
    font-weight: 600;
    color: #555;
  }

  .pi-contact dd {
    margin: 0;
  }

  .pi-contact a {
    color: inherit;
  }

  /* Links: icon + label, separated by | */
  .pi-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0 0 24px;
    font-size: 0.95rem;
    font-weight: 600;
  }

  .pi-links a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  .pi-links a:hover {
    text-decoration: underline;
  }

  .pi-links img {
    width: 20px;
    height: 20px;
    object-fit: contain;
  }

  .pi-links .bar {
    color: #bbb;
    font-weight: 400;
  }

  .pi-bio :global(p) {
    margin: 0;
    line-height: 1.85;
    color: #222;
  }

  /* CV table: period left, text right */
  .cv {
    margin-top: 48px;
  }

  .cv h3 {
    margin: 0 0 14px;
    padding-bottom: 8px;
    border-bottom: 1px solid #ddd;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-accent);
  }

  .cv dl {
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 10px 24px;
    margin: 0;
  }

  .cv dt {
    color: #555;
    white-space: nowrap;
  }

  .cv dd {
    margin: 0;
  }

  /* Advisor: italic, on its own line */
  .advisor {
    display: block;
    font-size: 0.88em;
    font-style: italic;
    color: #555;
  }

  @media (max-width: 720px) {

    .pi-top {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .pi-photo {
      max-width: 200px;
    }

    .cv dl {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .cv dd {
      margin-bottom: 10px;
    }
  }
</style>

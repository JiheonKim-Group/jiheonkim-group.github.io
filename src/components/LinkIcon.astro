---
// 연구자 링크 아이콘 (Google Scholar · LinkedIn · ORCID). 외부 파일 없이 SVG로 그린다.
interface Props {
  name?: 'scholar' | 'linkedin' | 'orcid';
  label: string;
}
const { name, label } = Astro.props;
---

{name === 'scholar' ? (
  <svg viewBox="0 0 32 32" width="100%" height="100%" role="img" aria-label={label}>
    <rect width="32" height="32" rx="6" fill="#4285F4" />
    <path d="M16 7 3.5 13.5 16 20l12.5-6.5Z" fill="#fff" />
    <path d="M9 17.2v4.6c0 1.9 3.1 3.4 7 3.4s7-1.5 7-3.4v-4.6L16 21Z" fill="#fff" />
    <path d="M26.2 14.7v6.3" stroke="#fff" stroke-width="1.4" />
    <circle cx="26.2" cy="21.6" r="1.2" fill="#fff" />
  </svg>
) : name === 'linkedin' ? (
  <svg viewBox="0 0 32 32" width="100%" height="100%" role="img" aria-label={label}>
    <rect width="32" height="32" rx="6" fill="#0A66C2" />
    <circle cx="9.5" cy="9.6" r="2.3" fill="#fff" />
    <rect x="7.5" y="13.2" width="4" height="11.8" fill="#fff" />
    <path d="M14.5 13.2h3.8v1.7c.6-1.1 2-2 4-2 3.6 0 4.2 2.3 4.2 5.4V25h-4v-5.9c0-1.5 0-3.2-2-3.2s-2.2 1.5-2.2 3.1V25h-3.8Z" fill="#fff" />
  </svg>
) : name === 'orcid' ? (
  <svg viewBox="0 0 32 32" width="100%" height="100%" role="img" aria-label={label}>
    <circle cx="16" cy="16" r="16" fill="#A6CE39" />
    <circle cx="10.4" cy="9.4" r="1.6" fill="#fff" />
    <rect x="9.1" y="12.6" width="2.6" height="11" fill="#fff" />
    <path d="M14.4 12.6h4.3c4.3 0 6.4 2.7 6.4 5.5 0 3-2.4 5.5-6.4 5.5h-4.3Zm2.6 2.3v6.4h1.6c2.9 0 3.9-1.6 3.9-3.2 0-1.7-1.1-3.2-3.8-3.2Z" fill="#fff" />
  </svg>
) : (
  <span>{label}</span>
)}

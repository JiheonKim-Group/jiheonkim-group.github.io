---
// Site footer: contact details and logos.
const kaistUrl = 'https://www.kaist.ac.kr/en/';
const cbeUrl = 'https://cbe.kaist.ac.kr/';
const pi = { name: 'Jiheon Kim', email: 'jiheon.kim@kaist.ac.kr', phone: '+82\u201142\u2011350\u20113944' };
// One array entry per displayed line.
// \u2011 = non-breaking hyphen, \u00a0 = non-breaking space.
const address = [
  'Bldg. W1\u20113, Rm. 3107, KAIST, 291\u00a0Daehak\u2011ro,',
  'Yuseong\u2011gu, Daejeon\u00a034141, Republic of Korea',
];
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <!-- Both logos share the same width and grid so their marks and wordmarks align vertically -->
    <div class="logos">
      <a href={kaistUrl} target="_blank" rel="noopener">
        <img
          src="/images/logo/kaist-lockup.svg"
          alt="KAIST — Korea Advanced Institute of Science and Technology"
          width="1013"
          height="119"
        />
      </a>
      <a class="cbe" href={cbeUrl} target="_blank" rel="noopener">
        <img
          src="/images/logo/cbe-lockup.svg"
          alt="Department of Chemical & Biomolecular Engineering, KAIST"
          width="1013"
          height="105"
        />
      </a>
    </div>

    <div class="info">
      <p class="heading">Contact</p>
      <p class="name">{pi.name} <span>(PI)</span></p>
      <dl>
        <dt>Email</dt>
        <dd><a href={`mailto:${pi.email}`}>{pi.email}</a></dd>
        <dt>Tel.</dt>
        <dd><a href={`tel:${pi.phone.replace(/[^+\d]/g, '')}`}>{pi.phone}</a></dd>
        <dt>Address</dt>
        <dd>{address.map((line) => <><span class="line">{line}</span>{' '}</>)}</dd>
      </dl>
    </div>
  </div>
  <p class="copyright">© {year} Jiheon Kim Group, KAIST</p>
</footer>

<style>
  /* Full-width band */
  .site-footer {
    margin-top: 64px;
    background: var(--color-bg);
  }

  .inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 40px 16px 24px;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 32px;
  }

  /* Logos (left) */
  .logos {
    flex: 0 0 440px;
  }

  .logos a,
  .logos img {
    display: block;
    width: 100%;
    height: auto;
  }

  /* Gap between logos, proportional to logo width (from the original grid) */
  .logos .cbe {
    margin-top: 4.3%;
  }

  /* Contact box (right) */
  .info {
    flex: 0 1 420px;
    /* Nudge so the text block top/bottom lines up with the logos */
    margin-top: -3px;
    font-size: 0.875rem;
    line-height: 20px;
    color: #555;
  }

  .info p {
    margin: 0;
  }

  .info .heading {
    margin-bottom: 11px;
    font-size: 0.8rem;
    line-height: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    color: #444;
  }

  .info .name {
    margin-bottom: 9px;
    font-weight: 700;
    color: #333;
  }

  .info .name span {
    font-weight: 400;
    color: #666;
  }

  /* Two-column label/value layout */
  .info dl {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 4px 16px;
    align-items: baseline;
    margin: 0;
  }

  .info dt {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #888;
  }

  .info dd {
    margin: 0;
  }

  .info .line {
    display: block;
  }

  .info a {
    color: var(--color-accent-light);
    text-decoration: none;
  }

  .info a:hover {
    text-decoration: underline;
  }

  .copyright {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 16px 24px;
    color: var(--color-muted);
    font-size: 0.75rem;
  }

  /* Mobile: contact box below the logos */
  /* Desktop: same 5:6 split as the home hero, so the contact box centers under the media column */
  @media (min-width: 901px) {
    .inner {
      display: grid;
      grid-template-columns: 5fr 6fr;
      gap: 48px;
    }

    .logos {
      width: 440px;
    }

    .info {
      justify-self: center;
      width: max-content;
    }
  }

  @media (max-width: 900px) {
    .inner {
      flex-direction: column;
      align-items: stretch;
    }

    .logos,
    .info {
      flex-basis: auto;
    }

    .logos {
      max-width: 380px;
    }

    /* Narrow screens: let the address wrap as one paragraph */
    .info .line {
      display: inline;
    }
  }
</style>
